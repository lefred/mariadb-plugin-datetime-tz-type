#
# DATETIME_WITH_TIME_ZONE plugin data type
#
SELECT
PLUGIN_NAME,
PLUGIN_VERSION,
PLUGIN_STATUS,
PLUGIN_TYPE,
PLUGIN_AUTHOR,
PLUGIN_DESCRIPTION,
PLUGIN_LICENSE,
PLUGIN_MATURITY,
PLUGIN_AUTH_VERSION
FROM INFORMATION_SCHEMA.PLUGINS
WHERE PLUGIN_TYPE='DATA TYPE'
    AND PLUGIN_NAME='datetime_with_time_zone';
PLUGIN_NAME	datetime_with_time_zone
PLUGIN_VERSION	1.0
PLUGIN_STATUS	ACTIVE
PLUGIN_TYPE	DATA TYPE
PLUGIN_AUTHOR	lefred
PLUGIN_DESCRIPTION	Data type DATETIME_WITH_TIME_ZONE
PLUGIN_LICENSE	GPL
PLUGIN_MATURITY	Beta
PLUGIN_AUTH_VERSION	1.0
SET time_zone='+05:30';
SET timestamp=1783063614;
CREATE TABLE ABC (ID INT, MyTime DATETIME);
CREATE TABLE XYZ (ID INT, MyTime DATETIME_WITH_TIME_ZONE);
SHOW CREATE TABLE XYZ;
Table	Create Table
XYZ	CREATE TABLE `XYZ` (
  `ID` int(11) DEFAULT NULL,
  `MyTime` datetime_with_time_zone NULL DEFAULT NULL
) ENGINE=MyISAM DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_uca1400_ai_ci
INSERT INTO ABC VALUES(1, CURRENT_TIMESTAMP);
INSERT INTO XYZ VALUES(1, CURRENT_TIMESTAMP);
INSERT INTO XYZ VALUES(2, '2026-07-03 08:12:20+01:00');
INSERT INTO XYZ VALUES(3, '2026-07-03 08:12:20+01');
INSERT INTO XYZ VALUES(4, '2026-07-03 08:12:20');
SELECT MyTime FROM ABC;
MyTime
2026-07-03 12:56:54
SELECT ID, MyTime FROM XYZ ORDER BY ID;
ID	MyTime
1	2026-07-03 12:56:54+05:30
2	2026-07-03 12:42:20+05:30
3	2026-07-03 12:42:20+05:30
4	2026-07-03 08:12:20+05:30
SET time_zone='-05:00';
SELECT MyTime FROM ABC;
MyTime
2026-07-03 12:56:54
SELECT ID, MyTime FROM XYZ ORDER BY ID;
ID	MyTime
1	2026-07-03 02:26:54-05:00
2	2026-07-03 02:12:20-05:00
3	2026-07-03 02:12:20-05:00
4	2026-07-02 21:42:20-05:00
DROP TABLE ABC;
DROP TABLE XYZ;
CREATE TABLE t1 (a DATETIME_WITH_TIME_ZONE(6));
SHOW CREATE TABLE t1;
Table	Create Table
t1	CREATE TABLE `t1` (
  `a` datetime_with_time_zone(6) NULL DEFAULT NULL
) ENGINE=MyISAM DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_uca1400_ai_ci
SET time_zone='+05:30';
SET timestamp=1783063614.123456;
INSERT INTO t1 VALUES (CURRENT_TIMESTAMP(6));
SELECT a FROM t1;
a
2026-07-03 12:56:54.123456+05:30
DROP TABLE t1;
CREATE TABLE t1 (a DATETIME_WITH_TIME_ZONE(7));
ERROR 42000: Too big precision specified for 'a'. Maximum is 6
SET timestamp=DEFAULT;
SET time_zone=DEFAULT;
